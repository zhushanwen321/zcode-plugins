{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "[Dd]ev[-_ ]?[Ff]low",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/bin/zdg.js\" hook user-prompt-submit",
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash|Edit|Write|Glob|Grep|ApplyPatch|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/bin/zdg.js\" hook mark",
            "timeoutMs": 5000
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/bin/zdg.js\" hook guard",
            "timeoutMs": 5000
          }
        ]
      }
    ]
  }
}
